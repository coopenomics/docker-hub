# Имя образа: dicoop/blockchain (из Docker Hub) или coopos-deb (локально собранный из .deb).
BLOCKCHAIN_IMAGE=dicoop/blockchain
# Тег образа: latest, v5.2.0, или для coopos-deb — 5.1.0/5.2.0.
BLOCKCHAIN_TAG=latest

# Дополнительные аргументы к nodeos (например, --snapshot /root/blockchain/snapshot.bin).
# Применяется только при ПУСТОМ data/ — иначе nodeos упадёт.
EXTRA_ARGS=

# Порты, проброшенные на хост.
NODE_HTTP_PORT=8888
NODE_P2P_PORT=9876
NODE_HISTORY_PORT=8088
